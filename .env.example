# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (anon / publishable). Es segura en el navegador porque RLS protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave PRIVADA service_role. Solo en el servidor. NUNCA con prefijo NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública de la web (para los enlaces de gestión de citas)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secreto aleatorio para proteger /api/cron/recordatorios en producción.
CRON_SECRET=

# WhatsApp Cloud API de Meta. Hasta activar el interruptor, los avisos siguen siendo manuales.
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=es_ES
WHATSAPP_TEMPLATE_APPOINTMENT=
# Fecha ISO desde la que se automatizan eventos nuevos. Evita enviar la cola histórica al activar.
WHATSAPP_AUTOMATION_START_AT=
# Opcionales: aviso interno al barbero cuando se crea, modifica o cancela una cita.
WHATSAPP_TEMPLATE_BARBER=
WHATSAPP_BARBER_PHONE=

# Correo transaccional con Resend. Verifica el dominio antes de activarlo.
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=LA BARBER STUDIO <citas@tudominio.es>
EMAIL_REPLY_TO=
# Fecha ISO desde la que se procesan eventos nuevos.
EMAIL_AUTOMATION_START_AT=
