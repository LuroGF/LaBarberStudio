# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (anon / publishable). Es segura en el navegador porque RLS protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave PRIVADA service_role. Solo en el servidor. NUNCA con prefijo NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública de la web (para los enlaces de gestión de citas)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secreto aleatorio para proteger /api/cron/recordatorios en producción.
CRON_SECRET=
